# Local development defaults. Copy to an ignored .env file only if your
# process manager loads dotenv files; the application itself reads environment
# variables and does not load this file automatically.
PANGEAWORLD_ENV=development
PANGEAWORLD_DATABASE_URL=sqlite:///backend/pangeaworld.db
PANGEAWORLD_MIGRATION_DATABASE_URL=
PANGEAWORLD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PANGEAWORLD_COOKIE_SECURE=0
VITE_API_URL=http://localhost:8000

# Optional locally; required on the production Render backend.
GEMINI_API_KEY=
GEMINI_ADVISOR_MODEL=
GEMINI_NEWS_MODEL=

# Render cron job only.
PANGEAWORLD_HEALTH_URL=https://pangeaworld-api.onrender.com/healthz
